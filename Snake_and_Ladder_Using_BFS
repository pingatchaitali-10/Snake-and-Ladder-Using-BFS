
# Case Study: Snake and Ladder using BFS
# Subject: Data Structures (SPPU SE Computer Engineering)

from collections import deque


def snake_and_ladder(snakes, ladders):
    board_size = 100

    # Combine snakes and ladders
    jumps = {}
    jumps.update(snakes)
    jumps.update(ladders)

    # BFS initialization
    queue = deque([1])
    visited = {1}
    parent = {1: None}
    dice_rolls = {1: 0}

    while queue:
        current = queue.popleft()

        # Destination reached
        if current == board_size:
            break

        # Try all possible dice values
        for dice in range(1, 7):
            next_position = current + dice

            if next_position > board_size:
                continue

            # Apply snake or ladder
            if next_position in jumps:
                next_position = jumps[next_position]

            if next_position not in visited:
                visited.add(next_position)
                parent[next_position] = current
                dice_rolls[next_position] = dice_rolls[current] + 1
                queue.append(next_position)

    # Check whether destination is reachable
    if board_size not in visited:
        print("Destination cannot be reached.")
        return

    # Reconstruct the path
    path = []
    position = board_size

    while position is not None:
        path.append(position)
        position = parent[position]

    path.reverse()

    print("\nSnake and Ladder Game")
    print("Minimum dice throws:", dice_rolls[board_size])
    print("Path followed:")

    for square in path:
        print(square, end="")

        if square != board_size:
            print(" -> ", end="")

    print()


# Snakes: starting square -> ending square
snakes = {
    17: 7,
    54: 34,
    62: 19,
    98: 79
}

# Ladders: starting square -> ending square
ladders = {
    3: 22,
    8: 30,
    20: 41,
    36: 57,
    71: 91,
    80: 100
}

# Run the program
snake_and_ladder(snakes, ladders)
